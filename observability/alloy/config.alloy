// Docker container logs → Loki. Prometheus scrapes Alloy on :12345.
// This socket is the list-and-logs proxy, not the Docker daemon.
discovery.docker "containers" {
  host = "unix:///run/docker-logs/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///run/docker-logs/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.drop_noise.receiver]
}

// mongo:8 healthcheck runs mongosh ping every 5s without SASL. MongoDB logs
// INFO "Connection not authenticating" for each of those localhost sockets.
loki.process "drop_noise" {
  stage.drop {
    expression          = "Connection not authenticating"
    drop_counter_reason = "mongodb_healthcheck"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
