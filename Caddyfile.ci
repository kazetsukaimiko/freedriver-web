{
	skip_install_trust
	local_certs
}

freedriver.io, www.freedriver.io {
	tls internal
	redir https://app.freedriver.io{uri} 308
}

auth.freedriver.io {
	tls internal
	encode gzip
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}

app.freedriver.io {
	tls internal
	encode gzip
	@dispatcherAdmin path /api/dispatcher/admin /api/dispatcher/admin/*
	handle @dispatcherAdmin {
		respond 404
	}
	@dispatcher path /mcp /mcp/* /dispatch/mcp /dispatch/mcp/* /api/dispatcher /api/dispatcher/*
	handle @dispatcher {
		reverse_proxy {
			dynamic a agent-dispatcher 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			lb_policy header Mcp-Session-Id {
				fallback round_robin
			}
		}
	}
	@autonomy path /autonomy/mcp /autonomy/mcp/* /api/autonomy /api/autonomy/*
	handle @autonomy {
		reverse_proxy {
			dynamic a autonomy-mcp 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			lb_policy header Mcp-Session-Id {
				fallback round_robin
			}
		}
	}
	handle {
		reverse_proxy {
			dynamic a dashboard 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
		}
	}
}

grafana.freedriver.io {
	tls internal
	encode gzip
	reverse_proxy grafana:3000
}

mqtt.freedriver.io {
	tls internal
	respond 404
}

verify.twilio.com {
	tls internal
	reverse_proxy twilio-stub:8080
}
