# Lives on the VPS at /opt/freedriver-secrets/.env (not in this repo).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_DB_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
# kaze's phone number in international form, e.g. +15555550100. sms seeds it once
# into its phone list (#168), and scripts/provision-keycloak-freedriver.sh sets it
# as the phone attribute of Keycloak user kaze (#169). Empty seeds nothing.
FREEDRIVER_SEED_PHONE=
