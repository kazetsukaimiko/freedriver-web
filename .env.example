# Lives on the VPS at /opt/freedriver-secrets/.env (not in this repo).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_DB_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
# kaze's phone number in international form, e.g. +15555550100. sms seeds it once
# into its phone list (#168), and scripts/provision-keycloak-freedriver.sh sets it
# as the phone attribute of Keycloak user kaze (#169). Empty seeds nothing.
FREEDRIVER_SEED_PHONE=
# placeholder only. Set the live cap in /opt/freedriver-secrets/.env.
# Counts sign-in texts that reach Twilio. Required, and only sms receives it.
FREEDRIVER_SMS_DAILY_SEND_CAP=100
# Dashboard instances store. Empty keeps the compose default
# mongodb://mongodb:27017/freedriver. Not a credential.
QUARKUS_MONGODB_CONNECTION_STRING=
# Shared so a login cookie from one dashboard instance is accepted on another.
# 32 characters. Required by compose. Live value is on the VPS only.
QUARKUS_OIDC_TOKEN_STATE_MANAGER_ENCRYPTION_SECRET=
