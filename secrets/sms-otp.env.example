# NOT A LIVE SECRET FILE. Docker Compose does not load this path.
# Do not copy these lines into the project as .env.
# Live value belongs only in /opt/freedriver-secrets/.env on the VPS.
# The placeholder below is rejected by the sms stub and the Keycloak SPI.
# Generate a real value on the host (do not commit it), for example:
#   openssl rand -base64 32
SMS_OTP_SHARED_SECRET=placeholder-not-a-live-secret
