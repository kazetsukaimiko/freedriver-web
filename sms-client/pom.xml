<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.freedriver</groupId>
        <artifactId>freedriver-web</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <groupId>io.freedriver.sms</groupId>
    <artifactId>sms-client</artifactId>
    <name>sms-client</name>
    <description>Proxy client for SmsApi over java.net.http. Java 21, for Keycloak 26.7. No JAX-RS client and no Quarkus.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <keycloak.dist.skip>false</keycloak.dist.skip>
        <!-- SHA-256 of keycloak-quarkus-dist-26.7.5.zip at keycloak.version. A keycloak.version change needs a new digest. -->
        <keycloak.dist.sha256>30ef87fb7101c43d29688d1ae80c0588ff4a151b3330e9f664bf9692d398658a</keycloak.dist.sha256>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.freedriver.sms</groupId>
            <artifactId>sms-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${keycloak.jackson.annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${keycloak.jackson.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${keycloak.jackson.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${keycloak.jakarta.ws.rs.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${keycloak.jakarta.validation.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-jaxrs-client-and-quarkus</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.quarkus</exclude>
                                        <exclude>io.quarkus.platform</exclude>
                                        <exclude>org.jboss.resteasy</exclude>
                                        <exclude>org.jboss.resteasy.microprofile</exclude>
                                        <exclude>org.glassfish.jersey</exclude>
                                        <exclude>org.glassfish.jersey.core</exclude>
                                        <exclude>org.eclipse.microprofile.rest.client</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-keycloak-dist-checksum</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${keycloak.dist.skip}</skip>
                            <rules>
                                <requireFileChecksum>
                                    <file>${project.build.directory}/keycloak-dist/keycloak-quarkus-dist.zip</file>
                                    <checksum>${keycloak.dist.sha256}</checksum>
                                    <type>sha256</type>
                                </requireFileChecksum>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-keycloak-dist</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <skip>${keycloak.dist.skip}</skip>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/keycloak</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>unzip-keycloak-dist</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${keycloak.dist.skip}</skip>
                            <target>
                                <unzip src="${project.build.directory}/keycloak-dist/keycloak-quarkus-dist.zip"
                                       dest="${project.build.directory}/keycloak"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-keycloak-dist</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>${keycloak.dist.skip}</skip>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.keycloak</groupId>
                                    <artifactId>keycloak-quarkus-dist</artifactId>
                                    <version>${keycloak.version}</version>
                                    <type>zip</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/keycloak-dist</outputDirectory>
                                    <destFileName>keycloak-quarkus-dist.zip</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <keycloak.home>${project.build.directory}/keycloak/keycloak-${keycloak.version}</keycloak.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>skip-keycloak-dist-on-skipTests</id>
            <activation>
                <property>
                    <name>skipTests</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <keycloak.dist.skip>true</keycloak.dist.skip>
            </properties>
        </profile>
        <profile>
            <id>skip-keycloak-dist-on-maven-test-skip</id>
            <activation>
                <property>
                    <name>maven.test.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <keycloak.dist.skip>true</keycloak.dist.skip>
            </properties>
        </profile>
        <profile>
            <id>skip-keycloak-dist-on-keycloak-home</id>
            <activation>
                <property>
                    <name>env.KEYCLOAK_HOME</name>
                </property>
            </activation>
            <properties>
                <keycloak.dist.skip>true</keycloak.dist.skip>
            </properties>
        </profile>
    </profiles>
</project>
