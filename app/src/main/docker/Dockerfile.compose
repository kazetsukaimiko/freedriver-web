# Multi-stage image for docker compose `build:` from the repo root.
#   docker build -f app/src/main/docker/Dockerfile.compose -t freedriver-app .
# mqtt-contract, mqtt, and mqtt-paho are reactor siblings; no GitHub Packages pin.

FROM maven:3.9-eclipse-temurin-23 AS build
WORKDIR /workspace

COPY pom.xml ./
COPY mqtt-contract/pom.xml mqtt-contract/pom.xml
COPY mqtt/pom.xml mqtt/pom.xml
COPY mqtt-paho/pom.xml mqtt-paho/pom.xml
COPY app/pom.xml app/pom.xml
COPY mqtt-contract/src mqtt-contract/src
COPY mqtt/src mqtt/src
COPY mqtt-paho/src mqtt-paho/src
COPY app/src app/src

ARG BUILD_NUMBER=1.0.0-SNAPSHOT
RUN set -eu; \
    mvn -B \
      org.codehaus.mojo:versions-maven-plugin:2.21.0:set \
      -DnewVersion="${BUILD_NUMBER}" \
      -DgenerateBackupPoms=false \
      -DprocessAllModules=true \
 && mvn -B -pl app -am -DskipTests \
      -Dquarkus.application.version="${BUILD_NUMBER}" \
      -Dquarkus.package.jar.manifest.attributes.Implementation-Version="${BUILD_NUMBER}" \
      package

FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:1.24
ENV LANGUAGE='en_US:en'

COPY --from=build --chown=185 /workspace/app/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /workspace/app/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /workspace/app/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /workspace/app/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
