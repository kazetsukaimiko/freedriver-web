<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.freedriver</groupId>
        <artifactId>freedriver-web-java</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>architecture-rules</artifactId>
    <name>freedriver-web-architecture-rules</name>
    <description>The Java layering rules and the architecture-role rules as ArchUnit rules, and the tests each service module runs them from. Services depend on it with test scope.</description>

    <properties>
        <!-- Files this module's tests read outside the module (#582). Each enters this module's
             build-cache key, so a change to one reruns these tests; .github/scripts/cache_inputs_check.py
             fails when a test reads an outside path that is missing here. -->
        <maven.build.cache.input.outside1>../stereotypes/src/test/resources/archunit-store</maven.build.cache.input.outside1>
        <maven.build.cache.input.outside2>../stereotypes/target/classes</maven.build.cache.input.outside2>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmolecules.integrations</groupId>
            <artifactId>jmolecules-archunit</artifactId>
            <version>${jmolecules-archunit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jmolecules</groupId>
            <artifactId>jmolecules-hexagonal-architecture</artifactId>
            <version>${jmolecules.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>io.freedriver</groupId>
            <artifactId>stereotypes</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
