<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.freedriver</groupId>
        <artifactId>freedriver-web-java</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>architecture-check</artifactId>
    <name>freedriver-web-architecture-check</name>
    <description>The reactor-wide architecture check: no package's main classes come from two reactor modules. It holds a test and no main code, and it is never deployed.</description>

    <properties>
        <!-- The main output of every module the test reads (#582). Each enters this module's
             build-cache key, so a change to one reruns the test; .github/scripts/cache_inputs_check.py
             fails when the test reads an outside path that is missing here. -->
        <maven.build.cache.input.outside1>../hit-window/target/classes</maven.build.cache.input.outside1>
        <maven.build.cache.input.outside2>../hit-window-testing/target/classes</maven.build.cache.input.outside2>
        <maven.build.cache.input.outside3>../stereotypes/target/classes</maven.build.cache.input.outside3>
        <maven.build.cache.input.outside4>../architecture-rules/target/classes</maven.build.cache.input.outside4>
        <maven.build.cache.input.outside5>../mcp-support/target/classes</maven.build.cache.input.outside5>
        <maven.build.cache.input.outside6>../dashboard-model/target/classes</maven.build.cache.input.outside6>
        <maven.build.cache.input.outside7>../dashboard-api/target/classes</maven.build.cache.input.outside7>
        <maven.build.cache.input.outside8>../dashboard/target/classes</maven.build.cache.input.outside8>
        <maven.build.cache.input.outside9>../agent-dispatcher-model/target/classes</maven.build.cache.input.outside9>
        <maven.build.cache.input.outside10>../agent-dispatcher-api/target/classes</maven.build.cache.input.outside10>
        <maven.build.cache.input.outside11>../agent-dispatcher/target/classes</maven.build.cache.input.outside11>
        <maven.build.cache.input.outside12>../autonomy-mcp/target/classes</maven.build.cache.input.outside12>
        <maven.build.cache.input.outside13>../device-daemon/target/classes</maven.build.cache.input.outside13>
        <maven.build.cache.input.outside14>../../mqtt-contract/target/classes</maven.build.cache.input.outside14>
        <maven.build.cache.input.outside15>../../mqtt/target/classes</maven.build.cache.input.outside15>
        <maven.build.cache.input.outside16>../../sms-model/target/classes</maven.build.cache.input.outside16>
        <maven.build.cache.input.outside17>../../sms-api/target/classes</maven.build.cache.input.outside17>
        <maven.build.cache.input.outside18>../../sms-client/target/classes</maven.build.cache.input.outside18>
        <maven.build.cache.input.outside19>../../sms/target/classes</maven.build.cache.input.outside19>
    </properties>

    <!-- Each judged module is a test dependency, so the reactor builds it first and its build-cache
         key is part of this module's. The test reads target/classes and needs none of their
         libraries, so every transitive dependency is excluded. -->
    <dependencies>
        <dependency>
            <groupId>io.freedriver</groupId>
            <artifactId>architecture-rules</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.freedriver</groupId>
            <artifactId>hit-window</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.freedriver</groupId>
            <artifactId>hit-window-testing</artifactId>
            <version>${project.version}</version>
