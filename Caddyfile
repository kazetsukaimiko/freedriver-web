freedriver.io, www.freedriver.io {
	redir https://app.freedriver.io{uri} 308
}

auth.freedriver.io {
	encode gzip
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}
	reverse_proxy keycloak:8080
}

app.freedriver.io {
	encode gzip
	reverse_proxy app:8080
}

# Public hostname kept so TLS/DNS stay put. Console is loopback-only.
grafana.freedriver.io {
	respond 404
}
