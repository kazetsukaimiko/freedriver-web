freedriver.io, www.freedriver.io {
	redir https://app.freedriver.io{uri} 308
}

auth.freedriver.io {
	encode gzip
	@admin path /admin /admin/*
	handle @admin {
		respond 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}

app.freedriver.io {
	encode gzip
	# The dispatcher's admin list is service to service: the dashboard reaches it on the compose network.
	@dispatcherAdmin path /api/dispatcher/admin /api/dispatcher/admin/*
	handle @dispatcherAdmin {
		respond 404
	}
	@dispatcher path /mcp /mcp/* /dispatch/mcp /dispatch/mcp/* /api/dispatcher /api/dispatcher/*
	handle @dispatcher {
		reverse_proxy {
			dynamic a agent-dispatcher 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			lb_policy header Mcp-Session-Id {
				fallback round_robin
			}
		}
	}
	@autonomy path /autonomy/mcp /autonomy/mcp/* /api/autonomy /api/autonomy/*
	handle @autonomy {
		reverse_proxy {
			dynamic a autonomy-mcp 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			lb_policy header Mcp-Session-Id {
				fallback round_robin
			}
		}
	}
	@invite path /invite /invite/*
	handle @invite {
		header Referrer-Policy "no-referrer"
		reverse_proxy {
			dynamic a dashboard 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			header_up -X-Freedriver-Internal
			header_up -X-Freedriver-Subject
			header_up -X-Freedriver-Roles
		}
	}
	handle {
		reverse_proxy {
			dynamic a dashboard 8080 {
				refresh 5s
			}
			fail_duration 10s
			lb_try_duration 5s
			header_up -X-Freedriver-Internal
			header_up -X-Freedriver-Subject
			header_up -X-Freedriver-Roles
		}
	}
}

# grafana.freedriver.io terminates TLS and reverse-proxies Grafana on grafana:3000.
# Host 127.0.0.1:3000 is SSH break-glass.
grafana.freedriver.io {
	encode gzip
	reverse_proxy grafana:3000
}

# Obtains the mqtt.freedriver.io certificate over ACME HTTP-01 and answers 404.
# Mosquitto serves MQTTS on 8883 with this certificate.
mqtt.freedriver.io {
	respond 404
}
