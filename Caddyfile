freedriver.io, www.freedriver.io {
	root * /srv
	encode gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

auth.freedriver.io {
	encode gzip
	reverse_proxy keycloak:8080
}

app.freedriver.io {
	encode gzip
	reverse_proxy app:8080
}

grafana.freedriver.io {
	encode gzip
	reverse_proxy grafana:3000
}
