# Every product path: lonewatt-architect approves. A later line wins, so the
# lines below override this default.
* @lonewatt-architect

# Contract modules: kazetsukaimiko approves. Listed alone, so only that approval
# satisfies the code-owner rule on these paths.
/java/*-api/ @kazetsukaimiko
/java/*-model/ @kazetsukaimiko
/java/*-contract/ @kazetsukaimiko
/*-api/ @kazetsukaimiko
/*-model/ @kazetsukaimiko
/*-contract/ @kazetsukaimiko

# Release files: lonewatt-techops merges the release-please Release pull request.
/.release-please-manifest.json @lonewatt-techops
/version.txt @lonewatt-techops
/java/dashboard/src/main/resources/changelog/CHANGELOG.md @lonewatt-techops

# Default for everything under .github, including new files.
/.github/ @kazetsukaimiko

# CI plumbing. A later line wins, so these override the default.
/.github/workflows/ci.yml                   @lonewatt-architect
/.github/workflows/commitlint.yml           @lonewatt-architect
/.github/workflows/pr-ready-when-green.yml  @lonewatt-architect
/.github/scripts/pr_ready_when_green.py     @lonewatt-architect
/.github/workflows/publish-sms.yml          @lonewatt-architect
/.github/workflows/release-please.yml       @lonewatt-architect
/.github/workflows/ci-notify-openbot.yml    @lonewatt-architect
/.github/workflows/pr-notify-openbot.yml    @lonewatt-architect
