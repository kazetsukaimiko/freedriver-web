<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.freedriver</groupId>
    <artifactId>freedriver-web</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>freedriver-web</name>
    <description>Freedriver portal: MQTT appliance contract and Quarkus app.</description>

    <modules>
        <module>mqtt-contract</module>
        <module>mqtt</module>
        <module>mqtt-paho</module>
        <module>java</module>
        <module>sms-model</module>
        <module>sms-api</module>
        <module>sms-client</module>
        <module>sms</module>
    </modules>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>23</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <lombok.version>1.18.48</lombok.version>
        <jackson.version>2.19.2</jackson.version>
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
        <junit.version>5.13.4</junit.version>
        <archunit.version>1.4.1</archunit.version>
        <!-- jMolecules architecture roles (#608). The ArchUnit integration 0.33.0 is built against jMolecules 1.10.0
             and ArchUnit 1.4.1; its 1.6.0 on Maven Central is an older 2022 release. -->
        <jmolecules.version>1.10.0</jmolecules.version>
        <jmolecules-archunit.version>0.33.0</jmolecules-archunit.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <jandex-plugin.version>3.6.0</jandex-plugin.version>
        <enforcer-plugin.version>3.5.0</enforcer-plugin.version>
        <!-- Versions Keycloak 26.7.5 puts on its runtime (Jackson, JAX-RS) or build (validation) classpath. -->
        <keycloak.jackson.version>2.21.7</keycloak.jackson.version>
        <keycloak.jackson.annotations.version>2.21</keycloak.jackson.annotations.version>
        <keycloak.jakarta.ws.rs.version>3.1.0</keycloak.jakarta.ws.rs.version>
        <keycloak.jakarta.validation.version>3.1.1</keycloak.jakarta.validation.version>
    </properties>

    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/kazetsukaimiko/freedriver-web</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Java layering, row 9 (#560): the Redis, HTTP and Keycloak clients the services use are the
                     Quarkus ones. LayeringRules.noForeignClients holds the same rule in the code. -->
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>banned-clients</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>Use the Quarkus Redis client, a REST client interface (or sms-client, device-daemon) and the Keycloak admin client the Quarkus extension provides.</message>
                                    <excludes>
                                        <exclude>redis.clients:jedis</exclude>
                                        <exclude>io.lettuce:lettuce-core</exclude>
                                        <exclude>org.redisson</exclude>
                                        <exclude>com.squareup.okhttp3</exclude>
                                        <exclude>org.asynchttpclient</exclude>
                                        <exclude>org.apache.httpcomponents:httpclient:*:*:compile</exclude>
                                        <exclude>org.apache.httpcomponents:httpclient:*:*:runtime</exclude>
                                        <exclude>org.apache.httpcomponents.client5:*:*:*:compile</exclude>
                                        <exclude>org.apache.httpcomponents.client5:*:*:*:runtime</exclude>
                                        <exclude>io.quarkus:quarkus-keycloak-admin-resteasy-client</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>no-plain-keycloak-admin-client</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <message>Declare io.quarkus:quarkus-keycloak-admin-rest-client; it brings the Keycloak admin client the services inject.</message>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>org.keycloak:keycloak-admin-client</exclude>
                                        <exclude>org.keycloak:keycloak-admin-client-jakarta</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <!-- Contract jars carry their own index so services need no quarkus.index-dependency entry. -->
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Implementation-Title>${project.artifactId}</Implementation-Title>
                                <Implementation-Version>${project.version}</Implementation-Version>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
